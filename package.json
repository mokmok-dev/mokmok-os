{
  "name": "@mokmok/web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test -- --watch",
    "build": "pnpm --filter @mokmok/web-console build",
    "mutants": "stryker run",
    "mutants:gate": "node scripts/mutation-gate.mjs",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "node scripts/dev.mjs",
    "start": "node packages/bridge/src/cli.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e && pnpm build && pnpm mutants && pnpm mutants:gate"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "ws": "^8.18.0"
  }
}
