{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@mokmok/web-protocol": ["./packages/protocol/src/index.ts"],
      "@mokmok/web-consumer": ["./packages/consumer/src/index.ts"],
      "@mokmok/web-bridge": ["./packages/bridge/src/index.ts"]
    }
  }
}
