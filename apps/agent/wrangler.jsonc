{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mokmok-os-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],

  // Code Mode's DynamicWorkerExecutor runs model-written code in here.
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "WorkflowRunner",
      },
    ],
  },

  "exports": {
    "WorkflowRunner": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
